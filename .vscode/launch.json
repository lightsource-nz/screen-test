{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // NOTE the board-specific configurations below name their ELF explicitly rather than using
    // ${command:cmake.launchTargetPath}. That variable resolves to whatever target the CMake
    // Tools extension currently has selected, which is not necessarily the one whose build tree
    // and SVD this configuration names -- and attaching an rp2040 debug session to an rp2350
    // image fails in confusing ways. Explicit paths cost a line and cannot disagree with
    // themselves.
    "version": "0.2.0",
    "configurations": [
        {
            //   RP2350 / Cortex-M33. NO "rtos" setting: openocd-rp2350.cfg no longer groups the
            // two M33s as an SMP hwthread pair, because examining core 1 at startup stalls this
            // firmware -- core 1 runs the log drain (and TinyUSB) and stops while holding the
            // stream lock, after which core 0 blocks forever on its next log call. See that file
            // for the measurements.
            //   asking for "hwthread" here against a server that no longer publishes one makes
            // the debugger and the server disagree about how many threads exist, so it has to
            // come out at the same time. Core 1 is still reachable on demand -- the config says
            // how.
            "name": "touch169 (rp2350)",
            "type": "cortex-debug",
            "servertype": "openocd",
            "request": "launch",
            "cwd": "${workspaceRoot}/build-waveshare-touch169",
            "configFiles": ["${workspaceRoot}/openocd-rp2350.cfg"],
            "searchDir": ["${env:LIGHT_OPENOCD_SCRIPTS}"],
            "svdFile": "${workspaceRoot}/../pico-sdk/src/rp2350/hardware_regs/RP2350.svd",
            "executable": "${workspaceRoot}/build-waveshare-touch169/module/light_ui_demo_touch169/light_ui_demo_touch169.elf",
            "windows": {
                "serverpath": "${env:LIGHT_OPENOCD_BIN}/openocd.exe",
                "armToolchainPath": "${env:LIGHT_ARM_TOOLCHAIN_BIN}"
            }
        },
        {
            //   RP2040. The build/ tree is shared by several presets, so confirm it is currently
            // configured for the rp2040 debug preset before relying on this.
            //   no "rtos" setting, for the same reason as the RP2350 entry above: openocd.cfg
            // no longer publishes an SMP hwthread group.
            "name": "po13 (rp2040)",
            "type": "cortex-debug",
            "servertype": "openocd",
            "request": "launch",
            "cwd": "${workspaceRoot}/build",
            "configFiles": ["${workspaceRoot}/openocd.cfg"],
            "searchDir": ["${env:LIGHT_OPENOCD_SCRIPTS}"],
            "svdFile": "${workspaceRoot}/../pico-sdk/src/rp2040/hardware_regs/RP2040.svd",
            "executable": "${workspaceRoot}/build/module/light_ui_demo_po13/light_ui_demo_po13.elf",
            "windows": {
                "serverpath": "${env:LIGHT_OPENOCD_BIN}/openocd.exe",
                "armToolchainPath": "${env:LIGHT_ARM_TOOLCHAIN_BIN}"
            }
        },
        {
            // whichever target CMake Tools has selected -- convenient while iterating, but it
            // is on you to make sure the selected target matches openocd.cfg and the SVD
            "name": "cortex-debug attach (selected target)",
            "type": "cortex-debug",
            "servertype": "openocd",
            "request": "launch",
            "cwd": "${workspaceRoot}/build",
            "configFiles": ["${workspaceRoot}/openocd.cfg"],
            "searchDir": ["${env:LIGHT_OPENOCD_SCRIPTS}"],
            "svdFile": "${workspaceRoot}/../pico-sdk/src/rp2040/hardware_regs/RP2040.svd",
            "executable": "${command:cmake.launchTargetPath}",
            "windows": {
                "serverpath": "${env:LIGHT_OPENOCD_BIN}/openocd.exe",
                "armToolchainPath": "${env:LIGHT_ARM_TOOLCHAIN_BIN}"
            }
        },
        {
            "name": "host-mode",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceRoot}/build-host",
            "program": "${command:cmake.launchTargetPath}"
        },
        {
            "name": "native-win64-gcc-12.1.0",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceRoot}/build-host",
            "miDebuggerPath": "${env:LIGHT_HOST_GDB}",
            "program": "${command:cmake.launchTargetPath}"
        }
    ]
}
