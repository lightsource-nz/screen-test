{
    "version": 6,
    "include": ["cmake/light_presets/light_presets.json"],
    "configurePresets": [
        {
            "name": "conf-screentest-base",
            "hidden": true,
            "inherits": ["conf-light-pico-base"],
            "binaryDir": "${sourceDir}/build",
            "generator": "Ninja",
            "cacheVariables": {
            }
        },
        {
            "name": "conf-screentest-host-debug",
            "inherits": [
                "conf-screentest-base",
                "conf-light-pico-host"
            ]
        },
        {
            "name": "conf-screentest-debug",
            "inherits": [
                "conf-screentest-base",
                "conf-light-pico",
                "conf-light-debug"
            ]
        },
        {
            "name": "conf-screentest-waveshare-touch169-debug",
            "inherits": [
                "conf-screentest-base",
                "conf-light-waveshare-touch169",
                "conf-light-debug"
            ],
            "binaryDir": "${sourceDir}/build-waveshare-touch169",
            "cacheVariables": {
                "PICO_STDIO_USB_CONNECT_WAIT_TIMEOUT_MS": "-1"
            }
        },
        {
            "name": "conf-screentest-waveshare-touch169-riscv-debug",
            "description": "Same board and same sources as conf-screentest-waveshare-touch169-debug, built for the RP2350's Hazard3 RISC-V cores instead of its Cortex-M33 pair. LIGHT_ARCH picks between the two archs the rp2350 chip entry registers, and light_resolve_pico_platform() turns that into PICO_PLATFORM=rp2350-riscv, from which pico-sdk selects its own RISC-V toolchain file. PICO_TOOLCHAIN_PATH is required rather than a convenience: the ARM trees find arm-none-eabi-gcc on PATH (PICO_TOOLCHAIN_PATH is empty in their caches) and there is only one PATH, so without it the SDK would search that same PATH for a riscv32-* compiler and find none. Setting it only here also keeps it out of the ARM trees.",
            "inherits": [
                "conf-screentest-base",
                "conf-light-waveshare-touch169",
                "conf-light-debug"
            ],
            "binaryDir": "${sourceDir}/build-waveshare-touch169-riscv",
            "cacheVariables": {
                "PICO_STDIO_USB_CONNECT_WAIT_TIMEOUT_MS": "-1",
                "LIGHT_ARCH": "riscv32",
                "PICO_TOOLCHAIN_PATH": "C:/Users/aful018/tools/riscv-toolchain-15-x64-win"
            }
        },
        {
            "name": "conf-screentest-trace",
            "inherits": [
                "conf-screentest-base",
                "conf-light-trace"
            ]
        },
        {
            "name": "conf-screentest-release",
            "inherits": [
                "conf-screentest-base",
                "conf-light-release"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "build-screentest-host",
            "configurePreset": "conf-screentest-host-debug"
        },
        {
            "name": "build-screentest_sh1106_spi4-debug",
            "configurePreset": "conf-screentest-debug",
            "targets": ["screentest_sh1106_spi4"]
        },
        {
            "name": "build-screentest_sh1106_i2c-debug",
            "configurePreset": "conf-screentest-debug",
            "targets": ["screentest_sh1106_i2c"]
        },
        {
            "name": "build-screentest_po13-debug",
            "configurePreset": "conf-screentest-debug",
            "targets": ["screentest_po13"]
        },
        {
            "name": "build-light_ui_po13-debug",
            "configurePreset": "conf-screentest-debug",
            "targets": ["light_ui_po13"]
        },
        {
            "name": "build-screentest-waveshare-touch169-debug",
            "configurePreset": "conf-screentest-waveshare-touch169-debug",
            "targets": ["screentest_ws_touch169"]
        },
        {
            "name": "build-light_ui_touch169-debug",
            "configurePreset": "conf-screentest-waveshare-touch169-debug",
            "targets": ["light_ui_touch169"]
        },
        {
            "name": "build-screentest-waveshare-touch169-riscv-debug",
            "configurePreset": "conf-screentest-waveshare-touch169-riscv-debug",
            "targets": ["screentest_ws_touch169"]
        },
        {
            "name": "build-light_ui_touch169-riscv-debug",
            "configurePreset": "conf-screentest-waveshare-touch169-riscv-debug",
            "targets": ["light_ui_touch169"]
        },
        {
            "name": "build-screentest-trace",
            "configurePreset": "conf-screentest-trace",
            "targets": ["screentest"]
        },
        {
            "name": "build-screentest-release",
            "configurePreset": "conf-screentest-release",
            "targets":["screentest"]
        }
    ]
}